{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User game stats and progression",
      "type": "object",
      "properties": {
        "coins": { "type": "number" },
        "xp": { "type": "number" },
        "stats": {
          "type": "object",
          "properties": {
            "matchesPlayed": { "type": "number" },
            "matchesWon": { "type": "number" },
            "totalRuns": { "type": "number" },
            "totalWickets": { "type": "number" },
            "highestScore": { "type": "number" }
          }
        },
        "dailyStreak": { "type": "number" },
        "lastLoginDate": { "type": "string" }
      },
      "required": ["coins", "xp", "stats", "dailyStreak", "lastLoginDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and stats"
    }
  }
}
